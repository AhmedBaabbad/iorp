APP_NAME=IORP Backend
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://iorp:iorp@localhost:5432/iorp
EMAIL_MODE=console
EMAIL_FROM=iorp@rehanh.com
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_TLS=false
SMTP_USER=iorp@rehanh.com
SMTP_PASSWORD=
PASSWORD_RESET_EXPIRY_MINUTES=30
ACCOUNT_INVITATION_EXPIRY_HOURS=24
FRONTEND_URL=http://localhost:3000
PLATFORM_FRONTEND_URL=http://localhost:3000
SECRET_KEY=change-me-in-local-env
ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_ISSUER=iorp-api
JWT_AUDIENCE=iorp-web
TENANT_ACCESS_TOKEN_MINUTES=15
PLATFORM_ACCESS_TOKEN_MINUTES=10
TENANT_REFRESH_TOKEN_DAYS=7
PLATFORM_REFRESH_TOKEN_HOURS=24
# SEC-004: a platform sign-in lasts at most this long, and ends after this long without use (must exceed PLATFORM_ACCESS_TOKEN_MINUTES)
PLATFORM_SESSION_MAX_HOURS=8
PLATFORM_IDLE_TIMEOUT_MINUTES=15
JWT_CLOCK_SKEW_SECONDS=30
REFRESH_COOKIE_NAME=iorp_refresh
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
IORP_REFRESH_RATE_LIMIT=30
LOG_LEVEL=INFO
IORP_BOOTSTRAP_TOKEN=
UPLOADS_DIR=uploads
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
IORP_LOGIN_MAX_ATTEMPTS=5
IORP_LOGIN_LOCKOUT_MINUTES=15
IORP_LOGIN_RATE_LIMIT=10
IORP_PLATFORM_LOGIN_MAX_ATTEMPTS=3
IORP_PLATFORM_LOGIN_LOCKOUT_MINUTES=30
IORP_PLATFORM_LOGIN_RATE_LIMIT=5
# Comma-separated direct proxy IPs whose final X-Forwarded-For hop is trusted.
IORP_TRUSTED_PROXY_IPS=127.0.0.1,::1

# Production orders: start released orders automatically when their planned start date arrives (default off).
PRODUCTION_AUTO_START_BY_DATE=false
PRODUCTION_AUTO_START_INTERVAL_MINUTES=15
EMAIL_FROM_NAME=IORP
SMTP_SSL=true
