[Unit]
Description=IORP %i encrypted offsite backup and restore verification
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
ConditionPathExists=/opt/apps/iorp/%i/env/backup-ops.env

[Service]
Type=oneshot
# Docker orchestration requires host administrator authority. No app container socket.
User=root
Group=root
UMask=0077
Environment=DOCKER_CONFIG=/home/rehanh/.docker
ExecStart=/opt/apps/iorp/%i/backup-runtime/venv/bin/python /opt/apps/iorp/%i/backup-runtime/source/backend/scripts/backup/ops_backup.py daily --config /opt/apps/iorp/%i/env/backup-ops.env
TimeoutStartSec=130min
TimeoutStopSec=3min
KillMode=control-group
Nice=15
IOSchedulingClass=idle
CPUQuota=50%
MemoryMax=768M
LimitFSIZE=10G
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/apps/iorp/%i/backups /opt/apps/iorp/%i/env/rclone /run/lock /home/rehanh/.docker
# Docker container limits are set independently; host unit limits do not constrain daemon children.
