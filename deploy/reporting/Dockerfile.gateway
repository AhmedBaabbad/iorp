# IORP report gateway: only POST /forms/chromium/convert/html reaches the renderer (backend/app/core/reporting/nginx.conf).
ARG NGINX_IMAGE=nginx:1.28-alpine@sha256:a8b39bd9cf0f83869a2162827a0caf6137ddf759d50a171451b335cecc87d236
FROM ${NGINX_IMAGE}
COPY backend/app/core/reporting/nginx.conf /etc/nginx/conf.d/default.conf
