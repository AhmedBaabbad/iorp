# Backend runtime configuration (copy per project; never commit). Values marked SECRET come from the secret manager.
APP_ENV=production
DEBUG=false
# SECRET — same password as the project's postgres env; host is the Compose service name.
DATABASE_URL=postgresql+psycopg://iorp:CHANGE_ME@postgres:5432/iorp
# SECRET — at least 32 random characters, distinct per project.
SECRET_KEY=
# Public HTTPS addresses (password-reset and activation links point here).
FRONTEND_URL=https://iorp.example.com
PLATFORM_FRONTEND_URL=https://iorp.example.com
CORS_ORIGINS=https://iorp.example.com
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=lax
# Our proxies only: the app network (IORP_APP_SUBNET) and Traefik's network subnet (docker network inspect).
# Never "*".
IORP_TRUSTED_PROXY_IPS=172.28.10.0/24,TRAEFIK_SUBNET_HERE
EMAIL_MODE=smtp
SMTP_HOST=
SMTP_PORT=465
SMTP_SSL=true
SMTP_TLS=false
SMTP_USER=
# SECRET
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=IORP
# SECRET — Fernet key(s), newest first; back them up apart from database backups (losing them disables enrolled MFA).
PLATFORM_MFA_KEYS=
# Enable only after enrollment and a tested operator recovery (docs/operations/PLATFORM_PRIVILEGED_SECURITY.md).
PLATFORM_MFA_REQUIRED=false
PRODUCTION_AUTO_START_BY_DATE=false
