# Host-only template; root-owned 600. Replace /REPLACE with the private deployment parent.
ENVIRONMENT=production
ENABLED=no
PRODUCTION_APPROVED=no
STATE_DIR=/REPLACE/production/backups
COMPOSE_FILE=/REPLACE/production/compose.yaml
COMPOSE_ENV_FILE=/REPLACE/production/env/project.env
DATABASE_ENV_FILE=/REPLACE/production/env/backup-database.env
KEY_ENV_FILE=/REPLACE/production/env/backup-key.env
PUSH_ENV_FILE=/REPLACE/production/env/backup-push.env
RCLONE_CONFIG=/REPLACE/production/env/rclone/rclone.conf
RCLONE_REMOTE=REPLACE_WITH_PRIVATE_REMOTE_NAME
MAX_SECONDS=7200
MIN_FREE_BYTES=2147483648
MAX_SCRATCH_BYTES=8589934592
MAX_PG_BYTES=8589934592
BANDWIDTH=8M
