# Host-only, root-owned 600. Change every staging path together for production.
ENVIRONMENT=staging
ENABLED=no
PRODUCTION_APPROVED=no
STATE_DIR=/opt/apps/iorp/staging/backups
COMPOSE_FILE=/opt/apps/iorp/staging/compose.yaml
COMPOSE_ENV_FILE=/opt/apps/iorp/staging/env/project.env
DATABASE_ENV_FILE=/opt/apps/iorp/staging/env/backup-database.env
KEY_ENV_FILE=/opt/apps/iorp/staging/env/backup-key.env
PUSH_ENV_FILE=/opt/apps/iorp/staging/env/backup-push.env
RCLONE_CONFIG=/opt/apps/iorp/staging/env/rclone/rclone.conf
RCLONE_REMOTE=iorpdrive
MAX_SECONDS=7200
MIN_FREE_BYTES=2147483648
MAX_SCRATCH_BYTES=8589934592
MAX_PG_BYTES=8589934592
BANDWIDTH=8M
