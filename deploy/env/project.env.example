# Compose interpolation for ONE project (copy to deploy/env/staging.env or production.env; never commit the copies).
#   docker compose --env-file deploy/env/staging.env -f deploy/compose.yaml up -d
IORP_PROJECT=iorp-staging
# Immutable image tag: the Git commit SHA that passed CI.
IORP_IMAGE_TAG=
IORP_REGISTRY=iorp
# The VPS's existing Traefik — verify with `docker network ls` and the Traefik configuration before use.
TRAEFIK_NETWORK=
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=
IORP_DOMAIN=
# Distinct per project on the same host (staging and production must not overlap).
IORP_APP_SUBNET=172.28.10.0/24
# Paths relative to deploy/ (the compose file's folder).
IORP_BACKEND_ENV_FILE=env/staging.backend.env
IORP_POSTGRES_ENV_FILE=env/staging.postgres.env
